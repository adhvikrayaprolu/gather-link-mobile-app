rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsGroup(gid) {
      return signedIn() && get(/databases/$(database)/documents/Groups/$(gid)).data.ownerUid == request.auth.uid;
    }
    function member(gid) {
      return signedIn() && (ownsGroup(gid) || exists(/databases/$(database)/documents/GroupMemberships/$(request.auth.uid + '_' + gid)));
    }
    match /Users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.userID == uid
        && request.resource.data.keys().hasOnly(['userID', 'firstName', 'lastName', 'email', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['userID', 'firstName', 'lastName', 'email'])
        && request.resource.data.firstName is string && request.resource.data.lastName is string;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName', 'lastName', 'updatedAt'])
        && !request.resource.data.keys().hasAny(['password']);
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    match /Groups/{gid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.groupId == gid
        && request.resource.data.groupName is string && request.resource.data.groupName.size() > 0;
      allow update: if ownsGroup(gid)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.groupId == gid;
      allow delete: if ownsGroup(gid);
      match /Posts/{pid} {
        allow read: if signedIn();
        allow create: if member(gid) && request.resource.data.userId == request.auth.uid
          && request.resource.data.groupId == gid
          && request.resource.data.message is string && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 2000;
        allow update: if signedIn() && request.resource.data.userId == resource.data.userId
          && request.resource.data.groupId == resource.data.groupId
          && ((resource.data.userId == request.auth.uid && member(gid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['message', 'postId'])
            && request.resource.data.message is string && request.resource.data.message.size() > 0
            && request.resource.data.message.size() <= 2000)
          || (member(gid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
            && request.resource.data.likes == resource.data.likes + 1));
        allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      }
    }
    match /GroupMemberships/{mid} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && mid == request.auth.uid + '_' + request.resource.data.groupId
        && exists(/databases/$(database)/documents/Groups/$(request.resource.data.groupId))
        && request.resource.data.keys().hasOnly(['userId', 'groupId', 'joinedAt']);
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinedAt']);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
